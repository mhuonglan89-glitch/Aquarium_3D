# Project: Aquarium_OpenGL_DevCpp_Starter
# Dev-C++ 5.11 / TDM-GCC 4.9.2 64-bit
# PHAN BIEN DICH DANH CHO NGUOI B (Shaders, Models, Textures, Particles)

CPP      = g++.exe
CC       = gcc.exe
WINDRES  = windres.exe
OBJ      = src/main.o src/cgltf.o glad/src/gl.o src/ParticleSystem.o src/Model.o src/Shader.o src/stb_image.o
LINKOBJ  = src/main.o src/cgltf.o glad/src/gl.o src/ParticleSystem.o src/Model.o src/Shader.o src/stb_image.o
LIBS     = -L"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib" -L"C:/Program Files (x86)/Dev-Cpp/MinGW64/x86_64-w64-mingw32/lib" -static-libgcc -L"lib" -lglfw3 -lgdi32 -luser32 -lopengl32
INCS     = -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/x86_64-w64-mingw32/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include" -I"include" -I"glad/include"
CXXINCS  = -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/x86_64-w64-mingw32/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include/c++" -I"include" -I"glad/include"
BIN      = Aquarium_OpenGL_Main.exe
CXXFLAGS = $(CXXINCS) -std=c++11
CFLAGS   = $(INCS)
RM       = rm.exe -f

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	$(RM) $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CPP) $(LINKOBJ) -o $(BIN) $(LIBS)

src/main.o: src/main.cpp include/Model.h include/Mesh.h include/Shader.h include/ParticleSystem.h include/stb_image.h
	$(CPP) -c src/main.cpp -o src/main.o $(CXXFLAGS)

src/cgltf.o: src/cgltf.c include/cgltf.h
	$(CC) -std=c99 -c src/cgltf.c -o src/cgltf.o $(CFLAGS)

glad/src/gl.o: glad/src/gl.c glad/include/glad/gl.h
	$(CC) -c glad/src/gl.c -o glad/src/gl.o $(CFLAGS)

src/ParticleSystem.o: src/ParticleSystem.cpp include/ParticleSystem.h
	$(CPP) -c src/ParticleSystem.cpp -o src/ParticleSystem.o $(CXXFLAGS)

src/Model.o: src/Model.cpp include/Model.h include/tiny_obj_loader.h include/stb_image.h include/cgltf.h
	$(CPP) -c src/Model.cpp -o src/Model.o $(CXXFLAGS)

src/Shader.o: src/Shader.cpp include/Shader.h
	$(CPP) -c src/Shader.cpp -o src/Shader.o $(CXXFLAGS)

src/stb_image.o: src/stb_image.c include/stb_image.h
	$(CC) -c src/stb_image.c -o src/stb_image.o $(CFLAGS)
