# Project: Aquarium_OpenGL_DevCpp_Starter
# Dev-C++ 5.11 / TDM-GCC 4.9.2 64-bit
# TICH HOP TOAN DIEN NGUOI A (Math, Camera, Tunnel, Bezier) & NGUOI B (Shaders, Models, Textures, Particles)

CPP      = g++.exe
CC       = gcc.exe
WINDRES  = windres.exe
OBJ      = src/main.o src/glad.o src/stb_image.o
LINKOBJ  = src/main.o src/glad.o src/stb_image.o
LIBS     = -L"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib" -L"C:/Program Files (x86)/Dev-Cpp/MinGW64/x86_64-w64-mingw32/lib" -static-libgcc -L"lib/mingw" -lglfw3 -lgdi32 -luser32 -lopengl32
INCS     = -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/x86_64-w64-mingw32/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include" -I"include"
CXXINCS  = -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/x86_64-w64-mingw32/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include" -I"C:/Program Files (x86)/Dev-Cpp/MinGW64/lib/gcc/x86_64-w64-mingw32/4.9.2/include/c++" -I"include"
BIN      = Aquarium_OpenGL_Main.exe
CXXFLAGS = $(CXXINCS) -std=c++11 -O2
CFLAGS   = $(INCS) -O2
RM       = rm.exe -f

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	$(RM) $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CPP) $(LINKOBJ) -o $(BIN) $(LIBS)

src/main.o: src/main.cpp include/Camera.h include/Tunnel.h include/BezierPath.h include/Shader.h include/Model.h include/Mesh.h include/ParticleSystem.h
	$(CPP) -c src/main.cpp -o src/main.o $(CXXFLAGS)

src/glad.o: src/glad.c
	$(CC) -c src/glad.c -o src/glad.o $(CFLAGS)

src/stb_image.o: src/stb_image.cpp
	$(CPP) -c src/stb_image.cpp -o src/stb_image.o $(CXXFLAGS)
